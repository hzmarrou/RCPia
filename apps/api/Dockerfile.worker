# RCPia job worker. The API image plus the agent runtime.
#
# **Why a second image rather than one.** The API never runs an agent -- it enqueues a job and
# returns -- so putting Node and the Pi runtime in the API image would add a toolchain to every
# web container to serve code that container never executes. The split also keeps the runtime
# pin in one place: this file, and the `package.json` it copies.
#
# Build from the repository root, because the pinned runtime manifest lives there:
#     docker build -f apps/api/Dockerfile.worker -t rcpia-worker .
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

ARG UV_DEFAULT_INDEX=https://pypi.org/simple
ARG NPM_CONFIG_REGISTRY=https://registry.npmjs.org/
# Node 22 is the runtime Pi is published against, pinned to an exact build.
#
# The major alone would not be a pin. `apt-get install nodejs` inside major 22 floats to
# whatever NodeSource published most recently, so two builds of the same commit could run
# an agent on two different interpreters -- which is the thing the Pi version pin exists
# to prevent. `runtime_version` records which Pi ran; this records which Node ran it.
#
# Bump deliberately. NodeSource eventually drops old point releases, so a build failing
# on "Version '...' for 'nodejs' was not found" means this needs raising, not that the
# pin is wrong.
ARG NODE_MAJOR=22
ARG NODE_VERSION=22.23.2-1nodesource1

ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX} \
    NPM_CONFIG_REGISTRY=${NPM_CONFIG_REGISTRY} \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    PYTHONUNBUFFERED=1 \
    # `/app/node_modules/.bin` carries the `pi` shim installed by `npm ci`. The adapter
    # finds the pinned package directly and does not need it, but a missing PATH entry was
    # half of the defect that made the deployed worker unable to launch the runtime at
    # all, so the shim stays reachable as a fallback.
    PATH="/app/.venv/bin:/app/node_modules/.bin:$PATH"

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && curl -fsSL "https://deb.nodesource.com/setup_${NODE_MAJOR}.x" | bash - \
    && apt-get install -y --no-install-recommends "nodejs=${NODE_VERSION}" \
    && apt-mark hold nodejs \
    && apt-get purge -y gnupg \
    && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# The agent runtime, installed from the repository's own pinned manifest.
#
# `npm ci` and the lockfile, not `npm install`: `^0.80.3` floats to 0.80.10, which removed an
# export this code calls, so an unpinned build produces a worker that fails at the first agent
# run rather than at build time. The whole scope is pinned in package.json, not just the entry
# package, because the four Pi packages are released together and mixing them breaks the same
# way.
COPY package.json package-lock.json* ./
RUN npm ci --omit=dev || npm install --omit=dev --no-audit --no-fund
ENV NODE_PATH=/app/node_modules

# Python dependency layer: cached until pyproject.toml/uv.lock change.
COPY apps/api/pyproject.toml apps/api/uv.lock ./
# **`--extra azure` is not optional for a container image.** The extra exists so an
# on-premises install can skip the SDK, and `rcpia.storage.azure_blob` imports it lazily
# so that skipping works. An image, though, is built once and may run against either
# provider: leaving it out produced a healthy API that accepted an upload and answered
# 500 with `No module named 'azure'` from inside `put_bytes`, after the case row had
# already been created. A few megabytes buys one image that runs in both places.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev --extra azure

COPY apps/api/README.md ./
COPY apps/api/rcpia ./rcpia
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-dev --extra azure

# **The agent folders travel in the image.** Compose bind-mounts `../agents:/app/agents:ro`,
# which made the image work locally while never being self-contained: the first Azure
# deployment started three replicas that each died with
# `worker cannot start: AGENTS_ROOT does not exist: /app/agents`.
#
# A brain is part of what the worker *is*, not configuration handed to it -- an image whose
# agents come from outside cannot be run anywhere the mount is absent, and cannot be pinned to
# a version either, since the folder could change under a running container.
COPY agents ./agents

# One job at a time, by design. Concurrency comes from running several of these containers and
# letting the queue's `FOR UPDATE SKIP LOCKED` hand each a different job -- never from running
# several agents inside one worker, which would share a lease and a heartbeat between runs that
# can each take minutes.
CMD ["python", "-m", "rcpia.worker"]
