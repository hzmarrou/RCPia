# RCPia v1 environment template.
# Copy to .env and fill in secrets. Never commit .env.
# Paths below are container paths (docker compose). For host-only runs, use
# host paths, e.g. LOCAL_BLOB_ROOT=./data/blobs and AGENTS_ROOT=./agents.

APP_ENV=local
DATABASE_URL=postgresql+psycopg://rcpia:rcpia@postgres:5432/rcpia
BLOB_PROVIDER=local
LOCAL_BLOB_ROOT=/data/blobs
# Only for BLOB_PROVIDER=azure; install the API's "azure" extra alongside it.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=rcpia
PARSER_PROVIDER=llamaparse
LLAMAPARSE_API_KEY=
PI_BIN=pi
AGENTS_ROOT=/app/agents
# Scratch space for task bundles and Pi sessions. Both are deleted once the session is
# archived to blob storage, but the directory holds patient data while a run is in
# flight, so it belongs on the same disk you would trust with the dossiers.
PI_WORK_ROOT=/tmp/rcpia-pi
# Ten minutes per agent, matching the design; the job lease is fifteen.
AGENT_TIMEOUT_SECONDS=600

# Azure OpenAI, from the RCPia Foundry workspace. Pi reads AZURE_OPENAI_BASE_URL —
# the ..._ENDPOINT name is ignored. Azure routes by *deployment* name, so agents name
# e.g. gpt-5.6-sol rather than gpt-5.6. See docs/credentials.md.
AZURE_OPENAI_BASE_URL=
AZURE_OPENAI_API_KEY=

AUTH_SECRET=change-me

# Session cookie topology.
# Leave SESSION_COOKIE_DOMAIN empty when the web app and API share one origin — locally
# both answer on localhost, and in production a reverse proxy in front of both is the
# preferred shape. Only set it (e.g. .rcpia.example.org) when they are deployed on
# sibling hostnames, in which case browsers also require SESSION_COOKIE_SAMESITE=none,
# which is a weaker position. See docs/decisions.md.
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAMESITE=lax

# Web -> API base URL (browser-visible in dev).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Host port for the Compose PostgreSQL service. Change if 5432 is already taken.
POSTGRES_PORT=5432
